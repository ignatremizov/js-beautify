#!/usr/bin/env bash

REL_SCRIPT_DIR="`dirname \"$0\"`"
SCRIPT_DIR="`( cd \"$REL_SCRIPT_DIR\" && pwd )`"
PROJECT_DIR="`( cd \"$SCRIPT_DIR/..\" && pwd )`"
NPM_PACKAGE=$(/usr/bin/env node -p 'require(process.argv[1]).packageManager' "$PROJECT_DIR/package.json") || exit $?
LOCAL_NPM_PACKAGE=$(/usr/bin/env node -p 'try { "npm@" + require(process.argv[1]).version } catch (_) { "" }' "$PROJECT_DIR/node_modules/npm/package.json") || exit $?

# Check metadata before executing npm: a stale cached major may not support Node.
if [ "$1" == "--version" ] || [ ! -f "${PROJECT_DIR}/node_modules/.bin/npm" ] || [ "$LOCAL_NPM_PACKAGE" != "$NPM_PACKAGE" ]; then
    echo "Ensuring repository-local $NPM_PACKAGE is installed..." >&2
    # The ambient npm may predate approval policies; bootstrap never runs scripts.
    /usr/bin/env npm i "$NPM_PACKAGE" --prefix "$PROJECT_DIR" --no-save --ignore-scripts >&2 || exit $?
fi

"${PROJECT_DIR}/node_modules/.bin/npm" "$@" || exit $?

# until this is fixed we ned to sed.
# https://npm.community/t/some-packages-have-dist-tarball-as-http-and-not-https/285/16
if [ -f package-lock.json ]; then
    if [ "`uname`" = "Darwin" ]; then
        sed -i '' -e 's/http:\/\//https:\/\//g' package-lock.json
    else
        sed -i -e 's/http:\/\//https:\/\//g' package-lock.json
    fi
fi
